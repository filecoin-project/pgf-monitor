{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "category", "sub_category", "function"],
        "properties": {
          "tier": {"enum": ["irreplaceable", "essential", "important", "nice-to-have"]},
          "category": {"enum": ["Blockchain Core & Physical Storage", "Coordination & Hardening", "Coordination & Incentives", "UX/DX", "Storage Market Middleware"]},
          "sub_category": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1},
          "value": {"type": "string"}
        }
      }
    }
  }
}
