{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grants"
  ],
  "properties": {
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application_funding_round",
          "application_funding_category",
          "application_ref_id",
          "application_name",
          "funded_project_name",
          "funded_project_oso_slug",
          "metrics_registry"
        ],
        "properties": {
          "application_funding_round": {
            "type": "string",
            "minLength": 1
          },
          "application_funding_category": {
            "enum": [
              "Kernel"
            ]
          },
          "application_ref_id": {
            "type": "string",
            "pattern": "^APP-[A-Z0-9]+-[A-Z0-9]+$"
          },
          "application_name": {
            "type": "string",
            "minLength": 1
          },
          "application_karma_project_slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "minLength": 2
          },
          "application_karma_project_id": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "funded_project_name": {
            "type": "string",
            "minLength": 1
          },
          "funded_project_oso_slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "minLength": 2
          },
          "metrics_registry": {
            "type": "string",
            "pattern": "^registry/(drafts/)?[a-z0-9-]+\\.yaml$"
          },
          "facts": {
            "type": "string",
            "pattern": "^contracts/[a-z0-9-]+\\.facts\\.yaml$"
          },
          "agreement_doc_id": {
            "type": "string",
            "minLength": 10
          },
          "note": {
            "type": "string"
          }
        },
        "dependencies": {
          "application_karma_project_id": [
            "application_karma_project_slug"
          ],
          "application_karma_project_slug": [
            "application_karma_project_id"
          ]
        }
      }
    }
  }
}
